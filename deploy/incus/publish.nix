# Publishing the built site to Jacobs web hosting (e4e@mywebsite.eng.ucsd.edu:htdocs/).
# Replaces _deploy_e4e-dev.sh on the retired deploy@kastner-ml.
#
# The split, and why:
#   1. The `build` job (GitHub-hosted) builds _site/ and uploads it as an artifact.
#   2. The `deploy` job runs on THIS slot's runner (label [self-hosted, e4e-website]).
#      It waits out any in-flight publish, downloads the artifact to STAGING/incoming,
#      renames it to STAGING/site, and starts `e4e-website-publish`.
#   3. That unit runs as its own unprivileged user, holds the SSH key, and rsyncs
#      STAGING/site to mywebsite.
# The runner (and so any workflow code) never sees the key. Its only extra powers are
# writing STAGING and STARTING this one unit (not stopping or restarting it: polkit
# matches the verb, so workflow code can't abort an rsync --delete halfway). The key
# reaches the unit through LoadCredential: systemd reads the root-only render and hands
# the unit a private copy.
#
# The key: tenants/e4e-website/generated/mywebsite-ssh, generated by krg-infra
# (terraform/secrets/e4e_website.tf). Its public half must be in the e4e account's
# ~/.ssh/authorized_keys on mywebsite (krg-infra docs/onboarding-e4e-website.md §2).
# vault-agent is FAIL-CLOSED: if that path is missing, the agent fails.
{pkgs, ...}: let
  name = "e4e-website";
  unit = "${name}-publish";
  runnerUser = "gh-runner"; # nixosModules.tenant's runner user
  publishUser = "${name}-publish";
  # The parent is root-owned, so the runner can fill STAGING but can't swap STAGING
  # itself. It CAN swap STAGING/site, so the unit refuses a symlink there; symlinks
  # INSIDE the site are skipped (rsync -r without -l/-L doesn't transfer them).
  base = "/var/lib/${name}";
  staging = "${base}/staging";
  site = "${staging}/site";
  keyRender = "/run/tenant/secrets/mywebsite_ed25519";
  remote = "e4e@mywebsite.eng.ucsd.edu";
  # Root-owned and created at boot (tmpfiles), not a RuntimeDirectory: systemd opens
  # StandardOutput before it creates RuntimeDirectory, so a log file inside one fails
  # the first start after each boot (209/STDOUT). Readable by the runner, so the deploy
  # job can show what happened (the runner can't read the journal).
  logDir = "/run/${unit}";
  # Pinned host key, collected 2026-10-15 from a campus host (ssh-keyscan via waiter).
  # If ETS rebuilds the box this changes and publishing fails closed. Re-check it from
  # campus before updating it here. In /etc so the runbook's manual check uses the
  # SAME pin as this unit.
  knownHosts = "/etc/ssh/mywebsite_known_hosts";
in {
  krg.vaultAgent.renders = [
    {
      destination = keyRender;
      perms = "0400"; # root only; the publish unit gets it via LoadCredential
      contents = ''{{ with secret "secret/data/tenants/e4e-website/generated/mywebsite-ssh" }}{{ .Data.data.private_key }}{{ end }}'';
    }
  ];

  environment.etc."ssh/mywebsite_known_hosts".text = ''
    mywebsite.eng.ucsd.edu ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMIpQdN25DmXhoY6GgzJXtoLAfaexv+hagR/1l41pthX
  '';

  users.users.${publishUser} = {
    isSystemUser = true;
    group = publishUser;
  };
  users.groups.${publishUser} = {};

  systemd.tmpfiles.rules = [
    "d ${base} 0755 root root -"
    # World-readable is fine: it holds the public website.
    "d ${staging} 0755 ${runnerUser} ${runnerUser} -"
    "d ${logDir} 0755 root root -"
  ];

  # The runner is ProtectSystem=strict: open exactly the staging dir for writing.
  services.github-runners.${name}.serviceOverrides.ReadWritePaths = [staging];

  systemd.services.${unit} = {
    description = "Publish the staged E4E website to ${remote}";
    restartIfChanged = false;
    wants = ["openbao-agent.service" "network-online.target"];
    after = ["openbao-agent.service" "network-online.target"];
    path = [pkgs.rsync pkgs.openssh pkgs.coreutils];
    serviceConfig = {
      Type = "oneshot";
      User = publishUser;
      Group = publishUser;
      LoadCredential = ["key:${keyRender}"];
      StandardOutput = "truncate:${logDir}/log";
      StandardError = "inherit";
      ProtectSystem = "strict";
      ProtectHome = true;
      PrivateTmp = true;
      NoNewPrivileges = true;
    };
    script = ''
      set -euo pipefail
      # --delete mirrors the site onto htdocs, so an empty or partial upload would wipe
      # the live site. The runner only renames a COMPLETE download into place, and the
      # build writes last_deployed.txt into every main build; require both, plus the
      # site root itself not being a symlink.
      if [ -L ${site} ] || [ ! -d ${site} ]; then
        echo "refusing to publish: ${site} is missing or a symlink"
        exit 1
      fi
      for f in index.html last_deployed.txt; do
        if [ ! -f ${site}/$f ]; then
          echo "refusing to publish: ${site}/$f is missing (rsync --delete would wipe the live site)"
          exit 1
        fi
      done
      echo "publishing $(tr '\n' ' ' < ${site}/last_deployed.txt)"
      rsync -r -c --delete --chmod=D755,F644 --stats \
        -e "ssh -i $CREDENTIALS_DIRECTORY/key -o IdentitiesOnly=yes -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${knownHosts}" \
        ${site}/ ${remote}:htdocs/
    '';
  };

  # Authorize ONLY the runner user to START ONLY this unit (as nixosModules.tenant does
  # for the self-update unit, but verb-scoped: no stop/restart of an in-flight publish).
  security.polkit.extraConfig = ''
    polkit.addRule(function(action, subject) {
      if (action.id == "org.freedesktop.systemd1.manage-units" &&
          action.lookup("unit") == "${unit}.service" &&
          action.lookup("verb") == "start" &&
          subject.user == "${runnerUser}") {
        return polkit.Result.YES;
      }
    });
  '';
}
